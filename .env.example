# Graph Lens Lite ingest service configuration.
# Copy to `.env` and adjust. Loaded automatically by `npm run serve:api`
# (Node --env-file-if-exists). Real environment variables take precedence and
# are preferred in production.

# Bearer token required for POST /api/graph. Set this once and reuse the same
# value across every app that pushes data. If unset, the service generates a
# random token on each start and prints it to the console (dev only).
GLL_API_TOKEN=change-me-to-a-long-random-string

# Port to listen on (default 7637).
GLL_API_PORT=7637

# Interface to bind. Default 127.0.0.1 (loopback only).
# Use 0.0.0.0 to accept connections from other machines — only behind a
# firewall or reverse proxy that protects the ingest endpoint.
GLL_API_HOST=127.0.0.1

# Maximum accepted request body size in bytes (default 26214400 = 25 MB).
GLL_MAX_BODY_BYTES=26214400

# Directory of the frontend to serve. Defaults to the bundled `src/`.
# GLL_STATIC_DIR=/opt/graph-lens-lite/src

# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Coverage reports (npm run test:coverage)
coverage/

# Generated bundle (rebuilt during dist/build)
src/gll.bundle.js
src/gll.bundle.js.map

# Perf benchmark artifacts (regenerate via npm run perf:fixture / npm run perf)
scripts/fixtures/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Python virtual environment
.venv/

# Local service configuration (token, port). Commit .env.example instead.
.env

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# VSCode
.vscode/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# manuscript
manuscript/**
!manuscript/**/*.tex
!manuscript/**/*.bib
!manuscript/**/*.png
!manuscript/**/*.jpg
!manuscript/**/*.svg

!manuscript/**/*.bst
!manuscript/**/*.cls
!manuscript/**/*.sty
!manuscript/**/*.md
!manuscript/**/

